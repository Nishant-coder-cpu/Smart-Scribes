# Copy to Web-Application/.env.local and fill in. Never commit the real file.

# --- Supabase (public: safe for the browser, protected by RLS) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Google Cloud Storage (server-only) ---
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=smart-scribes
NEXT_PUBLIC_GCS_BUCKET_NAME=smart-scribes
# Provide ONE of the following credential options:
# 1) Path to service-account JSON
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# 2) Inline JSON
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
# 3) Individual fields
# GCP_CLIENT_EMAIL=...
# GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- AI features (server-only) ---
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_SEARCH_API_KEY=your-custom-search-api-key
# Note: /api/chat reads SEARCH_ENGINE_ID while /api/qna/generate reads GOOGLE_SEARCH_ENGINE_ID
SEARCH_ENGINE_ID=your-search-engine-id
GOOGLE_SEARCH_ENGINE_ID=your-search-engine-id
