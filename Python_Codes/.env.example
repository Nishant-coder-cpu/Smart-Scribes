# Copy to Python_Codes/.env and fill in. Never commit the real .env.

# --- LLM ---
GEMINI_API_KEY=your-gemini-api-key
DEFAULT_LLM_PROVIDER=gemini
# Optional model overrides
# GEMINI_MODEL_FAST=gemini-3.8-flash
# GEMINI_MODEL_PRO=gemini-3.8-flash
# For AWS Bedrock instead of Gemini, set DEFAULT_LLM_PROVIDER=aws and configure
# AWS_REGION plus either AWS_BEARER_TOKEN_BEDROCK or AWS IAM credentials.
# AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key

# --- Google Cloud Storage ---
# Path to the service-account JSON (omit when running on GCP with default credentials)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
GCS_BUCKET_NAME=smart-scribes

# --- Hugging Face model cache ---
# Keep this outside source-controlled files. Package installation alone does
# not include model weights; pre-download them into this cache separately.
HF_HOME=C:/Smart-Scribes-model-cache
HF_HUB_DISABLE_XET=1
HF_HUB_DOWNLOAD_TIMEOUT=300
# Optional: a Hugging Face token increases public-model rate limits.
# HF_TOKEN=hf_...

# --- Optional local smoke-test inputs ---
# Set all three to process existing media directly and skip GCS downloads.
# PIPELINE_LOCAL_AUDIO=C:/path/to/lecture.mp3
# PIPELINE_LOCAL_VIDEO=C:/path/to/lecture.mp4
# PIPELINE_LOCAL_BOOK=C:/path/to/course-book.pdf

# --- Supabase (server-side job: use the service-role key, never expose it to the browser) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Tools ---
# Optional: only needed if ffmpeg / manim are not on PATH
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
MANIM_EXECUTABLE=manim

# --- Vision models ---
# GPU-safe defaults for a 6 GB GPU. Larger variants can be selected on
# hardware with enough VRAM for all vision and audio models at once.
TROCR_MODEL=microsoft/trocr-base-handwritten
BLIP_MODEL=Salesforce/blip-image-captioning-base
# Optional absolute snapshot path for an already-downloaded Whisper model.
# This prevents a cache lookup/download when model snapshots live in separate caches.
# HF_ASR_MODEL=C:/AIModels/SmartScribesHF/hub/models--openai--whisper-base/snapshots/<revision>
# PIPELINE_DISABLE_CAPTIONING=true
# PIPELINE_DISABLE_ASR=true
# PIPELINE_DISABLE_LLM=true
# Stop after local media processing, book matching, and the lecture document.
# This is useful for a deterministic local smoke run without Manim or publishing.
# PIPELINE_LOCAL_CORE_ONLY=true
# BOOK_MATCH_SIMILARITY_THRESHOLD=0.3

# --- Book ---
# Local name for the downloaded course PDF and its embeddings
# BOOK_NAME=course_book
